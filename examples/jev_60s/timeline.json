  "subtitles": [
    {
      "start": 0.78,
      "end": 2.525,
      "text": "最近有个模型叫 Jev"
    },
    {
      "start": 2.56,
      "end": 3.54,
      "text": "挺有意思的"
    },
    {
      "start": 3.64,
      "end": 4.88,
      "text": "你没法拿它聊天"
    },
    {
      "start": 4.96,
      "end": 6.74,
      "text": "但已经有人拿它打游戏了"
    },
    {
      "start": 8.58,
      "end": 10.4,
      "text": "先别脑补它盯着屏幕玩"
    },
    {
      "start": 10.72,
      "end": 11.82,
      "text": "官方的演示"
    },
    {
      "start": 12.08,
      "end": 14.14,
      "text": "给它的是整理好的游戏状态"
    },
    {
      "start": 15.48,
      "end": 16.86,
      "text": "比如角色在哪"
    },
    {
      "start": 17.16,
      "end": 17.82,
      "text": "障碍在哪"
    },
    {
      "start": 18.22,
      "end": 20.22,
      "text": "再告诉它，现在能往左"
    },
    {
      "start": 20.46,
      "end": 21.86,
      "text": "往右，或者原地等"
    },
    {
      "start": 23.34,
      "end": 24.04,
      "text": "它来选"
    },
    {
      "start": 24.42,
      "end": 25.34,
      "text": "程序负责按键"
    },
    {
      "start": 25.88,
      "end": 26.825,
      "text": "角色动了"
    },
    {
      "start": 26.86,
      "end": 28.24,
      "text": "再把新的情况交给它"
    },
    {
      "start": 28.78,
      "end": 29.985,
      "text": "放到你的 Agent 里"
    },
    {
      "start": 30.02,
      "end": 32.525000000000006,
      "text": "也可以先判断要不要搜索"
    },
    {
      "start": 32.56,
      "end": 34.919999999999995,
      "text": "该把任务交给哪个模型"
    },
    {
      "start": 35.9,
      "end": 37.739999999999995,
      "text": "普通大模型也能做这些"
    },
    {
      "start": 38.42,
      "end": 40.76,
      "text": "Jev 就是专门冲着这类判断来的"
    },
    {
      "start": 41.56,
      "end": 43.18,
      "text": "但它照样可能选错"
    },
    {
      "start": 44.2,
      "end": 45.419999999999995,
      "text": "右边明明有个坑"
    },
    {
      "start": 46.38,
      "end": 47.5,
      "text": "它还让你往右走"
    },
    {
      "start": 48.42,
      "end": 50.099999999999994,
      "text": "那不就掉下去了"
    },
    {
      "start": 51.38,
      "end": 53.099999999999994,
      "text": "所以，别光看它选得快"
    },
    {
      "start": 53.16,
      "end": 55.199999999999996,
      "text": "接进自己的工作流"
    },
    {
      "start": 55.5,
      "end": 56.239999999999995,
      "text": "少花了多少"
    },
    {
      "start": 56.58,
      "end": 57.63999999999999,
      "text": "选错了几次"
    },
    {
      "start": 58.0,
      "end": 59.13999999999999,
      "text": "一起算"
    }
  ]
}